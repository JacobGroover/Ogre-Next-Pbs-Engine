
# Auto-normalize text files and ensure consistent EOLs
* text=auto

# Scripts & source - force LF where appropriate
*.sh     text eol=lf
*.py     text eol=lf
*.m      text eol=lf
*.mm     text eol=lf
*.c      text eol=lf
*.cpp    text eol=lf
*.cc     text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.inl    text eol=lf
*.ipp    text eol=lf
*.tpp    text eol=lf
*.glsl   text eol=lf
*.metal  text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf
*.txt    text eol=lf
*.md     text eol=lf

# Xcode / plist/storyboard are XML/text
*.plist text
*.storyboard text
*.xib text

# Keep .gitattributes and .gitignore as text
.gitattributes text
.gitignore text

# Common binary formats - mark as binary (no text diffs / merges)
*.png  binary
*.jpg  binary
*.jpeg binary
*.dds  binary
*.tga  binary
*.bmp  binary
*.psd  binary
*.tif  binary
*.tiff binary
*.gif  binary
*.fbx  binary
*.blend binary
*.3ds  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.flac binary
*.zip  binary
*.tar  binary
*.gz   binary
*.7z   binary
*.exe  binary
*.dll  binary
*.lib  binary
*.a    binary
*.so   binary
*.dylib binary

