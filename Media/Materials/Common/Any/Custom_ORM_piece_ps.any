@piece( custom_ps_posMaterialLoad )
    // Listen for 'detail0_map' (The slot chosen for Engine's custom ORM)
    @property( detail0_map )
        
        // 1. Sample the ORM Texture
        // Ogre defines 'textureMaps' and 'samplerState' for us.
        // We use the index '@value(detail0_map_idx)' generated by Ogre.
        float4 ormTex = textureMaps@value(detail0_map_idx).Sample( 
                            samplerState@value(detail0_sampler), 
                            inPs.uv@value(uv_detail0) 
                        );

        // 2. Apply Data
        // Red   = Ambient Occlusion
        // Green = Roughness
        // Blue  = Metallic

        float ao_val    = ormTex.r;
        float rough_val = ormTex.g;
        float metal_val = ormTex.b;

        // 3. Apply Physics Properties
        pixelData.roughness = rough_val;

        // Apply Metalness (Manual calculation for safety)
        float custom_metalness = metal_val;

        // 4. Apply Ambient Occlusion
        // Multiply the existing Albedo (from PBSM_DIFFUSE) by the AO value.
        pixelData.diffuse.rgb *= ao_val;

        // PBR CALCULATION
        // Since we modified Metalness after Ogre's initial calculation, 
        // we must update the F0 (Specular) and Diffuse values.

        float3 kS_dielectric = float3(0.04, 0.04, 0.04);
        
        // Recalculate Specular: lerp(0.04, Albedo, Metalness)
        pixelData.specular.rgb = kS_dielectric + (pixelData.diffuse.rgb - kS_dielectric) * custom_metalness;

        // Recalculate Diffuse: Metal absorbs diffuse light
        pixelData.diffuse.rgb = pixelData.diffuse.rgb * (1.0 - custom_metalness);

    @end
@end
