[Essential]
Zip=@OGRE_MEDIA_DIR@Data/DebugPack.zip

[Popular]
FileSystem=@OGRE_MEDIA_DIR@Data
FileSystem=@OGRE_MEDIA_DIR@Data/Materials/Common
FileSystem=@OGRE_MEDIA_DIR@Data/Materials/Common/Any
FileSystem=@OGRE_MEDIA_DIR@Data/Materials/Common/GLSL
FileSystem=@OGRE_MEDIA_DIR@Data/Materials/Common/HLSL
FileSystem=@OGRE_MEDIA_DIR@Data/Materials/Common/Metal

# [NEW] Add this line so Ogre finds your custom shader piece
FileSystem=@OGRE_MEDIA_DIR@Data/Hlms/Pbs/Any

# Do not load this as a resource. It's here merely to tell the code where
# the Hlms templates are located
[Hlms]
DoNotUseAsResource=@OGRE_MEDIA_DIR@Data
